# Настройки развёртывания Zazzzor.
# Скопируйте этот файл в deploy/.env и заполните. Файл .env в git не попадает.

# --- Домен и HTTPS -----------------------------------------------------------

# Полное имя сервера: <поддомен>.duckdns.org
ZAZZZOR_DOMAIN=example.duckdns.org
# Порт, который слушает Caddy (HTTPS). Если 443 уже занят другим сервисом,
# поставьте 8443 и пробросьте на роутере внешний 443 -> 8443.
ZAZZZOR_HTTPS_PORT=443
# Необязательно: внешний порт для ссылок, если он отличается от ZAZZZOR_HTTPS_PORT
# (при пробросе внешний 443 -> 8443 раскомментируйте и оставьте 443).
# ZAZZZOR_PUBLIC_PORT=443
# Почта для Let's Encrypt (туда приходят предупреждения об истечении сертификата).
ACME_EMAIL=you@example.com

# --- DuckDNS ------------------------------------------------------------------

# Только поддомен, без .duckdns.org (для example.duckdns.org это example).
DUCKDNS_SUBDOMAIN=example
# Токен со страницы https://www.duckdns.org после входа.
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000

# --- LiveKit ------------------------------------------------------------------

# Ключ и секрет API. Сгенерируйте свои:
#   ключ:   openssl rand -hex 16   (например, APIa1b2c3...)
#   секрет: openssl rand -hex 32
# Секрет должен быть не короче 32 символов.
LIVEKIT_API_KEY=CHANGE_ME_openssl_rand_hex_16
LIVEKIT_API_SECRET=CHANGE_ME_openssl_rand_hex_32_at_least_32_chars

# Медиа-порты (пробросить на роутере). Сигнализация идёт через Caddy по HTTPS.
# TCP-запасной канал для тех, у кого UDP заблокирован.
LIVEKIT_TCP_PORT=7881
# Основной UDP-порт для всего медиа (один порт на всех).
LIVEKIT_UDP_PORT=7882
# Встроенный TURN (UDP).
LIVEKIT_TURN_UDP_PORT=3478

# --- Версии образов (только конкретные теги, не latest) -------------------------

LIVEKIT_VERSION=v1.13.10
LIVEKIT_CLI_VERSION=v2.19.0
CADDY_VERSION=2.11.7
DUCKDNS_IMAGE_VERSION=8d8f7eba-ls94
