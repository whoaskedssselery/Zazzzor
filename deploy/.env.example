# Zazzzor deployment settings. Copy this file to deploy/.env and fill it in.
# Git ignores .env. Docker Compose reports any required setting left empty.
# Настройки развёртывания Zazzzor.
# Скопируйте этот файл в deploy/.env и заполните. Файл .env в git не попадает.
# Пустые обязательные значения не дадут запустить `docker compose up`:
# compose остановится с сообщением, какую переменную заполнить.

# --- Domain and HTTPS / Домен и HTTPS ----------------------------------------

# Full server hostname, for example zazzzor.duckdns.org.
# Полное имя сервера: <поддомен>.duckdns.org, например zazzzor.duckdns.org
ZAZZZOR_DOMAIN=
# Caddy's HTTPS port. If 443 is in use, set 8443 and forward external 443 to 8443.
# Порт, который слушает Caddy (HTTPS). Если 443 уже занят другим сервисом,
# поставьте 8443 и пробросьте на роутере внешний 443 -> 8443.
ZAZZZOR_HTTPS_PORT=443
# Optional public port for links. With external 443 forwarded to internal 8443,
# uncomment this line and leave the value at 443.
# Необязательно: внешний порт для ссылок, если он отличается от ZAZZZOR_HTTPS_PORT
# (при пробросе внешний 443 -> 8443 раскомментируйте и оставьте 443).
# ZAZZZOR_PUBLIC_PORT=443
# Email address for Let's Encrypt certificate notices.
# Ваша почта для Let's Encrypt (туда приходят предупреждения об истечении
# сертификата), например ivan@mail.ru
ACME_EMAIL=

# --- DuckDNS ------------------------------------------------------------------

# DuckDNS subdomain without .duckdns.org, for example zazzzor.
# Только поддомен, без .duckdns.org (для zazzzor.duckdns.org это zazzzor).
DUCKDNS_SUBDOMAIN=
# Sign in at https://www.duckdns.org and copy the token shown there.
# Токен со страницы https://www.duckdns.org после входа (строка вида
# xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx в поле token).
DUCKDNS_TOKEN=

# --- LiveKit ------------------------------------------------------------------

# The Zazzzor API uses these LiveKit credentials to sign voice tokens and
# verify webhooks. Generate the key with openssl rand -hex 16 and the secret
# with openssl rand -hex 32. The secret must be at least 32 characters.
# Ключ и секрет API LiveKit; ими же API Zazzzor подписывает токены голосовых
# каналов и проверяет вебхуки. Сгенерируйте свои и вставьте результат:
#   LIVEKIT_API_KEY:    openssl rand -hex 16
#   LIVEKIT_API_SECRET: openssl rand -hex 32   (не короче 32 символов)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Forward the media ports on your router. Signaling uses HTTPS through Caddy.
# TCP is the fallback for clients with UDP blocked.
# Медиа-порты (пробросить на роутере). Сигнализация идёт через Caddy по HTTPS.
# TCP-запасной канал для тех, у кого UDP заблокирован.
LIVEKIT_TCP_PORT=7881
# Main shared UDP port for media.
# Основной UDP-порт для всего медиа (один порт на всех).
LIVEKIT_UDP_PORT=7882

# Optional public node IP. If unset, LiveKit discovers it via STUN at startup.
# Set this if STUN is unavailable. This disables STUN, so update the value and
# restart LiveKit when the IP changes. Required behind Traefik (section 17).
# Необязательно: внешний (публичный) IP сервера. Пусто — LiveKit сам узнаёт его
# через STUN при запуске. Задайте, если STUN недоступен: тогда STUN не
# используется вовсе, а при смене IP значение надо поменять вручную и
# перезапустить livekit. За Traefik (раздел 17) обязательно.
# LIVEKIT_NODE_IP=203.0.113.7
# Optional comma-separated STUN servers to replace LiveKit's built-in servers.
# Example: stun.cloudflare.com:3478,stun.l.google.com:19302
# Необязательно: свои STUN-серверы через запятую вместо встроенных в LiveKit
# (Google, Twilio), например stun.cloudflare.com:3478,stun.l.google.com:19302
# LIVEKIT_STUN_SERVERS=stun.cloudflare.com:3478

# --- API and database / API и база данных ------------------------------------

# Generate a PostgreSQL password with openssl rand -hex 24. Use only hex,
# since it is inserted directly into the connection URL. PostgreSQL uses
# this on initialization. To change an existing password, see deploy/README.md.
# Пароль PostgreSQL. Сгенерируйте и вставьте результат: openssl rand -hex 24
# (только hex: пароль подставляется в адрес подключения без экранирования).
# Задаётся один раз: при первом запуске база создаётся с этим паролем, и
# смена значения здесь потом пароль в базе НЕ меняет (см. deploy/README.ru.md).
POSTGRES_PASSWORD=
# Comma-separated logins, such as ivan,petya, reserved for administrators:
# create each account with `zazzzor create-admin <login>` (section 10 of
# deploy/README.md). Ordinary sign-up under these logins is refused, and
# registration is closed on a fresh database.
# Логины администраторов через запятую, например ivan,petya. Аккаунт с таким
# логином создаётся только командой `zazzzor create-admin <логин>` (раздел 10
# deploy/README.ru.md); обычная регистрация под ним отклоняется, а на новой
# базе регистрация вообще закрыта.
ZAZZZOR_ADMIN_USERNAMES=
# API port on loopback for Caddy. Change it if port 8080 is already in use.
# Порт API на 127.0.0.1 (только для Caddy, наружу не открывается). Меняйте,
# если 8080 на сервере уже занят.
ZAZZZOR_API_PORT=8080
# Docker Swarm only (section 15 of deploy/README.md). Metrics and PostgreSQL
# ports bind to host loopback. Change either if check-ports.sh reports a conflict.
# Только для docker stack (раздел 15 deploy/README.ru.md): порты на 127.0.0.1
# хоста для метрик API и для Postgres. Меняйте, если check-ports.sh скажет,
# что они заняты.
# ZAZZZOR_METRICS_PORT=9464
# POSTGRES_PORT=55432
# Optional addresses from which the API trusts X-Forwarded-For. If your Docker
# subnet differs, see the networking section of deploy/README.md.
# Необязательно: от каких адресов API верит заголовку X-Forwarded-For (это
# Caddy). По умолчанию 172.16.0.0/12,127.0.0.1/32 — см. раздел «Сеть и адреса
# клиентов» в deploy/README.ru.md, если подсеть Docker другая.
# ZAZZZOR_TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1/32

# --- Pinned image and plugin versions / Версии образов и плагинов -------------

LIVEKIT_VERSION=v1.13.10
LIVEKIT_CLI_VERSION=v2.19.0
CADDY_VERSION=2.11.7
# Caddy builds github.com/caddy-dns/duckdns into its image.
# Плагин DuckDNS для Caddy (github.com/caddy-dns/duckdns), собирается в образ.
DUCKDNS_PLUGIN_VERSION=v0.5.0
DUCKDNS_IMAGE_VERSION=8d8f7eba-ls94
# Use the same PostgreSQL tag as server/internal/platform/testkit and the backup image.
# Тот же тег, что в server/internal/platform/testkit (на нём идут тесты).
# Сервис backup (резервные копии) работает в образе с этим же
# тегом.
POSTGRES_VERSION=18.6-alpine

# --- Backups / Резервные копии (section 12 / раздел 12) -----------------------

# Absolute host path for backups. Create it before starting the stack.
# Каталог копий на хосте, абсолютный путь. Создайте его до запуска:
# sudo install -d -o 65532 -g 65532 -m 0700 /srv/zazzzor-backups
ZAZZZOR_BACKUP_DIR=/srv/zazzzor-backups
# Optional time zone and local time for daily backups (HH:MM). Defaults shown.
# Необязательно (значения по умолчанию указаны). Часовой пояс и время
# ежедневной копии (ЧЧ:ММ):
# TZ=Europe/Warsaw
# ZAZZZOR_BACKUP_TIME=04:30
# Keep the latest backup from each of the last N days and M weeks.
# Сколько копий хранить: последнюю за каждый из N последних дней и M недель.
# ZAZZZOR_BACKUP_KEEP_DAILY=7
# ZAZZZOR_BACKUP_KEEP_WEEKLY=4
# How long deleted images stay in the trash. Use more than 24h (192h = 8 days).
# Сколько удалённые картинки лежат в корзине; больше суток (192h = 8 суток).
# ZAZZZOR_FILE_RETENTION=192h

# Per-user attachment quota in bytes. Use 0 to disable the quota.
# Лимит вложений на пользователя в байтах, 0 отключает лимит.
# ZAZZZOR_ATTACHMENT_QUOTA_BYTES=2147483648
# Minimum free space on the file volume in bytes. Use 0 to disable the check.
# Минимум свободного места на томе файлов в байтах, 0 отключает проверку.
# ZAZZZOR_MIN_FREE_BYTES=2147483648

# --- Swarm behind Traefik / Swarm за Traefik (section 17 / раздел 17) ---------

# Traefik mode only. Uncomment and edit the settings listed in the guide.
# stack.sh rejects duplicate keys.
# Нужно только этому варианту. Раскомментируйте и измените строки, которые
# называет README; не дописывайте те же ключи ниже: на повторе ключа
# stack.sh остановится.
# Edge proxy: caddy (with DuckDNS) or traefik.
# Вариант стека: caddy (edge Caddy с DuckDNS) или traefik.
# ZAZZZOR_EDGE=caddy
# Traefik's external overlay network, HTTPS entry point, and certificate resolver.
# Внешняя overlay-сеть, HTTPS-entrypoint и resolver сертификатов Traefik.
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
# Exact CIDR of the Traefik network (docker network inspect traefik).
# CIDR только сети Traefik (docker network inspect traefik), не 10.0.0.0/8.
# TRAEFIK_SUBNET=10.0.1.0/24
# TURN/TLS on port 443 through a dedicated hostname and a Traefik TCP router.
# TURN/TLS на 443 через отдельный домен и TCP-router Traefik.
# LIVEKIT_TURN_ENABLED=false
# LIVEKIT_TURN_DOMAIN=turn.example.org
# Image repositories. For GHCR, set the repository names and pass the tags on deploy.
# Репозитории образов; для GHCR замените оба и задайте оба тега при deploy.
# ZAZZZOR_API_REPOSITORY=zazzzor-api
# ZAZZZOR_CADDY_REPOSITORY=zazzzor-caddy
# Backup image (PostgreSQL with scripts). Its tag defaults to the API tag.
# Specify ZAZZZOR_BACKUP_TAG to override it.
# Образ заданий резервного копирования (Postgres со скриптами); тег по
# умолчанию тот же, что у API (ZAZZZOR_BACKUP_TAG задаёт другой).
# ZAZZZOR_BACKUP_REPOSITORY=zazzzor-backup
