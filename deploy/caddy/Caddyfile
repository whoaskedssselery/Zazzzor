{
	email {$ACME_EMAIL}
	https_port {$ZAZZZOR_HTTPS_PORT}
	# Port 80 is never opened: certificates come via DNS-01 (DuckDNS).
	auto_https disable_redirects
	# No admin API on :2019 (the host may already run its own Caddy there);
	# config changes are applied by restarting the container.
	admin off
}

{$ZAZZZOR_DOMAIN} {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
		# Check the DNS-01 TXT record through public resolvers, not the host's
		# (often an ISP or router cache that delays propagation checks).
		resolvers 1.1.1.1 8.8.8.8
	}

	redir /connectivity-test /connectivity-test/ permanent

	handle_path /connectivity-test/* {
		# Only the static page is compressed; signaling below is not touched.
		encode zstd gzip
		header {
			Content-Security-Policy "default-src 'self'; connect-src 'self' wss:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:"
			Referrer-Policy no-referrer
			X-Content-Type-Options nosniff
		}
		# index.html must be revalidated so a rebuilt page reaches everyone;
		# assets have content hashes in their names and may be cached for long.
		@index path / /index.html
		header @index Cache-Control no-cache
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		root * /srv/connectivity-test
		file_server
	}

	# LiveKit signaling (WebSocket). The server API (/twirp) is deliberately
	# not exposed: tokens are issued locally by deploy/scripts/make-test-links.sh.
	handle /rtc* {
		reverse_proxy 127.0.0.1:7880
	}

	# Zazzzor API, published by compose on 127.0.0.1 only. reverse_proxy
	# passes the WebSocket upgrade of /api/v1/gateway through and sets no read
	# timeout, so long-lived connections stay open. Incoming X-Forwarded-For
	# from clients is replaced, so the API sees the real client address.
	handle /api/* {
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
		# JSON is compressed; images under /api/v1/files are already
		# compressed and the gateway is a WebSocket.
		@compressible not path /api/v1/files/* /api/v1/gateway
		encode @compressible zstd gzip
		reverse_proxy 127.0.0.1:{$ZAZZZOR_API_PORT}
	}

	# The web client (a single-page app) on every other path. Paths it does not
	# know get index.html with 200 and the client router shows its own page.
	@web not path /api/* /rtc* /connectivity-test*
	handle @web {
		encode zstd gzip
		header {
			Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
			Referrer-Policy no-referrer
			X-Content-Type-Options nosniff
		}
		root * /srv/web
		# Built files have content hashes in their names and may be cached for
		# long; a missing one is a plain 404 (not cached), never index.html
		# parsed as a script.
		@assets path /assets/*
		@hashed {
			path /assets/*
			file
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		handle @assets {
			file_server
		}
		# index.html (and anything else) is revalidated, so a new build reaches
		# everyone on the next load.
		@notAssets not path /assets/*
		header @notAssets Cache-Control no-cache
		handle {
			try_files {path} /index.html
			file_server
		}
	}

	# /connectivity-test followed by anything other than "/".
	handle {
		respond 404
	}
}
