# ТОЛЬКО ДЛЯ ПРОВЕРОК, НЕ ДЛЯ ЗАПУСКА. Заведомо фальшивые значения, чтобы
# проверять конфигурацию без настоящих секретов:
#   docker compose --env-file deploy/.env.ci -f deploy/docker-compose.yml config --quiet
#   ENV_FILE=deploy/.env.ci ZAZZZOR_API_TAG=ci ZAZZZOR_CADDY_TAG=ci bash deploy/scripts/stack.sh config
# и `caddy validate` в собранном образе. Домен .invalid не существует,
# токен и секрет ничего не открывают. Для сервера используйте deploy/.env
# (копия .env.example).

ZAZZZOR_DOMAIN=zazzzor-ci.example.invalid
ZAZZZOR_HTTPS_PORT=443
ACME_EMAIL=ci@example.invalid

DUCKDNS_SUBDOMAIN=zazzzor-ci
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000

LIVEKIT_API_KEY=APItestonly
# Фиктивный hex-секрет, только для проверок.
LIVEKIT_API_SECRET=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

LIVEKIT_VERSION=v1.13.10
LIVEKIT_CLI_VERSION=v2.19.0
CADDY_VERSION=2.11.7
DUCKDNS_PLUGIN_VERSION=v0.5.0
DUCKDNS_IMAGE_VERSION=8d8f7eba-ls94
POSTGRES_VERSION=18.6-alpine

# Фиктивный пароль базы, только для проверок.
POSTGRES_PASSWORD=cafecafecafecafecafecafecafecafecafecafecafecafe
ZAZZZOR_ADMIN_USERNAMES=ci_admin
ZAZZZOR_API_PORT=8080

# Фиктивный каталог копий, только для проверок конфигурации.
ZAZZZOR_BACKUP_DIR=/srv/zazzzor-ci-backups

# Фиктивные адреса для рендера Traefik-варианта (LIVEKIT_NODE_IP задаёт
# stack-test.sh: здесь он выключил бы STUN в edge-рендере).
TRAEFIK_SUBNET=10.99.0.0/24
LIVEKIT_TURN_DOMAIN=turn-ci.example.invalid
