{
  "name": "zazzzor",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "gen:api": "pnpm --filter @zazzzor/web gen:api",
    "dev": "pnpm --filter @zazzzor/web dev",
    "e2e": "pnpm --filter @zazzzor/connectivity-test e2e",
    "format": "biome format --write",
    "check": "biome check --error-on-warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
